      "absolute_path": "题包内：S03_采购复核委托与已发布文件.docx",
      "url": "assets/tasks/GO-TIME-003/environment/input_files/S03_%E9%87%87%E8%B4%AD%E5%A4%8D%E6%A0%B8%E5%A7%94%E6%89%98%E4%B8%8E%E5%B7%B2%E5%8F%91%E5%B8%83%E6%96%87%E4%BB%B6.docx",
