config_version=5

[application]
config/name="Input Harbour | UI routing lab"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=480

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035,0.065,0.10,1)
