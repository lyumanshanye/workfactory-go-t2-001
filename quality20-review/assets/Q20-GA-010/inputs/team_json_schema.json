{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestContentPackage",
  "description": "团队引擎消费的任务配置包结构规范",
  "type": "object",
  "properties": {
    "quests": {
      "type": "array",
      "description": "任务列表",
      "items": {
        "type": "object",
        "properties": {
          "quest_id": {
            "type": "string",
            "description": "任务唯一标识"
          },
          "display_name": {
            "type": "string",
            "description": "任务显示名称"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "前置任务ID列表"
          },
          "unlock_conditions": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer",
                "description": "最低等级要求"
              },
              "required_items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "需要持有的物品ID列表"
              }
            },
            "required": [
              "level",
              "required_items"
            ],
            "additionalProperties": false,
            "description": "可选的解锁条件"
          },
          "rewards": {
            "type": "object",
            "properties": {
              "experience": {
                "type": "integer",
                "description": "经验值奖励"
              },
              "currency": {
                "type": "integer",
                "description": "金币奖励"
              },
              "loot": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "item_id": {
                      "type": "string",
                      "description": "物品ID"
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "物品数量，最小为1"
                    }
                  },
                  "required": [
                    "item_id",
                    "quantity"
                  ],
                  "additionalProperties": false
                },
                "description": "物品掉落列表"
              }
            },
            "required": [
              "experience",
              "currency",
              "loot"
            ],
            "additionalProperties": false,
            "description": "任务奖励"
          }
        },
        "required": [
          "quest_id",
          "display_name",
          "dependencies",
          "rewards"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "quests"
  ],
  "additionalProperties": false
}