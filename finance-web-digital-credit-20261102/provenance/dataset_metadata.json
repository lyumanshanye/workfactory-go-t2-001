{"status":"OK","data":{"id":13995850,"identifier":"DVN/6RK7RD","persistentUrl":"https://doi.org/10.7910/DVN/6RK7RD","protocol":"doi","authority":"10.7910","separator":"/","publisher":"Harvard Dataverse","publicationDate":"2026-06-11","storageIdentifier":"s3://10.7910/DVN/6RK7RD","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":997,"datasetType":"dataset","locks":[],"latestVersion":{"id":735423,"datasetId":13995850,"datasetPersistentId":"doi:10.7910/DVN/6RK7RD","datasetType":"dataset","storageIdentifier":"s3://10.7910/DVN/6RK7RD","versionNumber":1,"internalVersionNumber":9,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","UNF":"UNF:6:+04AUxov+F24hKpgTz8NqA==","lastUpdateTime":"2026-06-11T14:00:44Z","releaseTime":"2026-06-11T14:00:44Z","createTime":"2026-06-09T13:53:18Z","publicationDate":"2026-06-11","citationDate":"2026-06-11","effectiveDatasetFileCountLimit":1000,"datasetFileUploadsAvailable":997,"license":{"name":"CC0 1.0","uri":"http://creativecommons.org/publicdomain/zero/1.0","iconUri":"https://licensebuttons.net/p/zero/1.0/88x31.png","rightsIdentifier":"CC0-1.0","rightsIdentifierScheme":"SPDX","schemeUri":"https://spdx.org/licenses/","languageCode":"en"},"fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Data for: DIGITAL CREDIT AND INDEBTEDNESS IN BRAZIL"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Fletcher Leadership Program for Financial Inclusion"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"The Fletcher School, Tufts University"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Banco Central do Brasil"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Plano CDE"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Fletcher Leadership Program for Financial Inclusion"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"Mir_Ahmad_Shekib.Mir@tufts.edu"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"Dataset resulting from an online survey with 1,000 participants conducted in Brazil in 2025 with the financial and technical support of FLPFI. The research project was designed and directed by the Central Bank of Brazil (BCB) in partnership with Plano CDE. To implement the survey, a structured questionnaire was developed based on insights from prior focus groups and administered through an online panel. The sample targeted individuals from middle and lower socioeconomic classes (C, D, and E), classified according to the Brazilian Economic Classification Criterion and cross-checked with self-reported income. The sample was weighted to represent the population with internet access in these groups, ensuring a maximum margin of error of 3 percentage points at a 95% confidence level. The questionnaire covered topics such as consumption habits, digital credit offers and uptake, use of credit, attitudes toward risk, default, and perceived causes of default. As the data are based on self-reported responses, results may differ from official statistics derived from administrative records."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2025"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"k